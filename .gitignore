# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Data and results (never commit datasets or model weights).
# The empty data/ folder skeleton is kept with .gitkeep files; images are never tracked.
data/**
!data/**/
!data/**/.gitkeep
# outputs/: the small result files (config.yaml, history.csv, summary.json, eval_*.csv) are committed;
# the model weights (best.pt, caught by *.pt below) and the quick test runs are not.
outputs/*_notebook_demo/
*.pt
*.pth

# Secrets
kaggle.json
access_token
.env

# Notebooks / OS / editors
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/
